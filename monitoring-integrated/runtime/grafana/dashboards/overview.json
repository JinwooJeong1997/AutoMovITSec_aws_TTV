{
  "uid": "integrated-web",
  "title": "웹 서비스 통합 관제",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "선택 조건 · 최근 5분 요청",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-access\",server=~`^${server:regex}$`} | json | __error__=\"\" | ip =~ `^${ip:regex}$` | path =~ `^${path:regex}$` | status =~ `^${status:regex}$` | event_type =~ `^${event:regex}$`[5m]))",
          "queryType": "instant",
          "legendFormat": "{{server}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "선택 조건 · 최근 5분 4xx",
