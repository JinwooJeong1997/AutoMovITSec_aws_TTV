      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-access\",server=~`^${server:regex}$`} | json | __error__=\"\" | ip =~ `^${ip:regex}$` | path =~ `^${path:regex}$` | status =~ `^${status:regex}$` | event_type =~ `^${event:regex}$` | status >= 400 | status < 500 [5m])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "{{server}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
