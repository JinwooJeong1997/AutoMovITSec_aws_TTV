    {
      "id": 3,
      "title": "선택 조건 · 최근 5분 5xx",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-access\",server=~`^${server:regex}$`} | json | __error__=\"\" | ip =~ `^${ip:regex}$` | path =~ `^${path:regex}$` | status =~ `^${status:regex}$` | event_type =~ `^${event:regex}$` | status >= 500 | status < 600 [5m])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "{{server}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
