{
  "uid": "security-demo",
  "title": "웹 보안 관제 · Loki 로그 실험실",
  "description": "모든 로그는 synthetic=true인 합성 데이터입니다. Loki 자체가 공격을 판정하지 않습니다.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "loki",
    "security",
    "synthetic"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "전체 요청 / 최근 1분",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-demo\", server=~\"$server\"}[1m]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "공격 의심 / 최근 1분 (합성 분류)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-demo\", server=~\"$server\"} | json | attack_type != \"none\" [1m])) or vector(0)",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "5xx 오류율 / 최근 1분",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(count_over_time({job=\"web-demo\", server=~\"$server\"} | json | status >= 500 [1m])) or vector(0)) / sum(count_over_time({job=\"web-demo\", server=~\"$server\"}[1m]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "모의 차단 / 최근 1분",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"web-demo\", server=~\"$server\"} | json | action = \"blocked\" [1m])) or vector(0)",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "서버별 요청/초",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate({job=\"web-demo\", server=~\"$server\"}[1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "상태 코드별 요청/분",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({job=\"web-demo\", server=~\"$server\"} | json[1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "공격 의심 유형별 요청/분",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (attack_type) (count_over_time({job=\"web-demo\", server=~\"$server\"} | json | attack_type != \"none\" [1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "응답시간 p95 / 최근 1분",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"web-demo\", server=~\"$server\"} | json | unwrap duration_ms | __error__=\"\" [1m]) by (server)",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "공격 의심 IP Top 5 / 선택 기간",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (ip) (count_over_time({job=\"web-demo\", server=~\"$server\"} | json | attack_type != \"none\" [$__range])))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "5xx 오류 로그",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"web-demo\", server=~\"$server\"} | json | status >= 500",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 11,
      "title": "전체 원본 로그 · 합성 데이터",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"web-demo\", server=~\"$server\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{server}} {{attack_type}} {{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "서버",
        "type": "custom",
        "query": "web-01,web-02",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "web-01",
            "value": "web-01"
          },
          {
            "text": "web-02",
            "value": "web-02"
          }
        ]
      }
    ]
  }
}
